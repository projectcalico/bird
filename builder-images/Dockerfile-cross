FROM debian:13
LABEL maintainer="maintainers@tigera.io"

# One compiler version for every architecture: Debian's native GCC for the
# build machine, and its packaged cross compilers for the rest. BIRD is built
# without the interactive client, so no target libraries beyond libc are needed.
RUN apt-get update && \
	apt-get --no-install-recommends install -y \
	autoconf bison flex gcc libc6-dev m4 make \
	gcc-aarch64-linux-gnu libc6-dev-arm64-cross \
	gcc-arm-linux-gnueabihf libc6-dev-armhf-cross \
	gcc-mips64el-linux-gnuabi64 libc6-dev-mips64el-cross \
	gcc-powerpc64le-linux-gnu libc6-dev-ppc64el-cross \
	gcc-s390x-linux-gnu libc6-dev-s390x-cross && \
	rm -rf /var/lib/apt/lists/*

WORKDIR /code
